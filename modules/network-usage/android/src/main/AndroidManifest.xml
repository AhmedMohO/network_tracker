<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Granted by the user in Settings, not at runtime. tools:ignore silences
         the ProtectedPermissions lint error, which is expected for this one. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to resolve UIDs to app names on API 30+. Play Store policy
         restricts this permission; we are not shipping through Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The APK update channel (Task 23). This app ships outside the Play
         Store, so it installs its own updates through the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_paths" />
        </provider>
    </application>
</manifest>
